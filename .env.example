# GEMINI_API_KEY: Required for server-side Gemini AI shopping assistant calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Server listening port (must be 3000 in AI Studio preview)
PORT="3000"

# Optional Email Notification Integration (SMTP / Transactional Email)
# Configure these to enable outbound order & alert emails via server webhook.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@veltrix.example"

# Optional Payment Gateway Integration (Stripe / PayHere)
# Online card checkout remains in Reservation/COD mode until live credentials are configured.
PAYMENT_GATEWAY_PROVIDER=""
STRIPE_SECRET_KEY=""
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
